# RERANK_API_KEY=replace-with-rerank-api-key
# RERANK_MODEL=your-rerank-model
RERANK_TOP_N=5
RERANK_SCORE_THRESHOLD=0.30
RERANK_TIMEOUT_SECONDS=5
TOOL_TIMEOUT_SECONDS=5
LLM_TIMEOUT_SECONDS=15
VECTOR_TIMEOUT_SECONDS=5
